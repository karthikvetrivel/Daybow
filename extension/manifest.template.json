{
  "manifest_version": 3,
  "name": "Daybow",
  "version": "__VERSION__",
  "description": "Every Google Calendar event, color-coded by category as you create it. Jev from TypeSafe picks the category.",
  "key": "__PUBLIC_KEY__",
  "permissions": ["identity", "alarms", "storage"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://api.typesafe.ai/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Daybow", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [
    { "matches": ["https://calendar.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
