# Copy this file to .env.local and fill in the values. See the README, "Configuration".

# Google OAuth client (Web application). See the README, "Set up Google sign-in".
# scripts/set-google-client.sh fills in both values from the client JSON that Google gives you.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jev (TypeSafe) API key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# 16 or more random characters. Signs session cookies and encrypts refresh tokens.
# Generate one: openssl rand -base64 48
APP_SECRET=

# Shared secret for the cron route. Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when this variable is set.
CRON_SECRET=

# Public URL of the deployment, no trailing slash. Used for the OAuth
# redirect URI and for Google push notifications. Leave empty in local dev.
BASE_URL=

# Optional tuning
# LABEL_MIN_CONFIDENCE=0.3
# LABEL_WINDOW_PAST_DAYS=7
# LABEL_WINDOW_FUTURE_DAYS=60
# JEV_MODEL=jev-latest

# Storage. Set STORE_BACKEND=file, blob, or redis to force one backend.
# Otherwise the app picks one, in this order:
# 1. BLOB_READ_WRITE_TOKEN            -> Vercel Blob (create a Blob store in the Vercel dashboard)
# 2. UPSTASH_REDIS_REST_URL + _TOKEN  -> Upstash Redis (KV_REST_API_URL and _TOKEN also work)
# 3. none                             -> local JSON file at .data/store.json
