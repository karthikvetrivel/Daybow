{
  "name": "daybow",
  "version": "0.1.0",
  "description": "Every Google Calendar event, color-coded by category as you create it. A Chrome extension and a small web app, powered by Jev from TypeSafe.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/karthikvetrivel/Daybow.git"
  },
  "homepage": "https://github.com/karthikvetrivel/Daybow#readme",
  "bugs": {
    "url": "https://github.com/karthikvetrivel/Daybow/issues"
  },
  "keywords": [
    "daybow",
    "google-calendar",
    "chrome-extension",
    "calendar",
    "productivity",
    "color-coding",
    "classification",
    "jev",
    "typesafe",
    "nextjs",
    "vercel"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension/tsconfig.json",
    "test": "vitest run",
    "eval": "tsx scripts/eval-real-events.ts",
    "deploy": "vercel deploy --prod --yes",
    "build:extension": "node scripts/build-extension.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
